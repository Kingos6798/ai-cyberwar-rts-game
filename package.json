{
  "name": "ai-cyberwar-rts",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source RTS where humans fight an LLM-commanded AI faction for compute, bandwidth, and data.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node scripts/sim.ts",
    "balance": "node scripts/balance.ts",
    "replay": "node scripts/replay.ts",
    "llm-turn": "node --env-file-if-exists=.env scripts/llm-turn.ts",
    "llm-match": "node --env-file-if-exists=.env scripts/llm-match.ts",
    "android:sync": "vite build && cap sync android",
    "icons": "node scripts/make-icons.ts",
    "shot": "node scripts/shot.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@fontsource/chakra-petch": "^5.3.0",
    "pixi.js": "^8.22.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
